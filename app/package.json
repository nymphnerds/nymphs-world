{
  "name": "nymphs-world",
  "version": "0.2.4",
  "private": true,
  "description": "Nymphs World by Nymphs - WORBI-derived worldbuilding workspace for NymphsCore",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "start": "npm run start --prefix server",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:server": "vitest run --project server",
    "test:client": "vitest run --project client",
    "maintenance:report": "node server/src/scripts/maintenance.js",
    "maintenance:fix": "node server/src/scripts/maintenance.js --fix",
    "maintenance:review": "node server/src/scripts/maintenance.js --review",
    "account:list": "node server/src/scripts/account.js --list",
    "account:list:json": "node server/src/scripts/account.js --list --format json",
    "account:show": "node server/src/scripts/account.js --show",
    "account:add": "node server/src/scripts/account.js --add",
    "account:delete": "node server/src/scripts/account.js --delete",
    "account:purge": "node server/src/scripts/account.js --purge",
    "suite": "node server/src/scripts/suite.js"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.0",
    "concurrently": "^8.2.2",
    "esbuild": "^0.28.0",
    "vitest": "^3.0.0"
  }
}
