{
  "name": "nymphs-world-server",
  "version": "0.2.0",
  "private": true,
  "description": "Nymphs World WORBI-derived backend server",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "vitest": "^1.6.0",
    "supertest": "^7.0.0"
  }
}
