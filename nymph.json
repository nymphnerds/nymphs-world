{
  "manifest_version": 1,
  "id": "nymphs-world",
  "name": "Nymphs World",
  "short_name": "NW",
  "version": "0.2.2",
  "description": "Private development build of Nymphs World using the current WORBI workspace as its UI and app base.",
  "category": "tool",
  "kind": "worldbuilding",
  "packaging": "repo",
  "repo": {
    "url": "https://github.com/nymphnerds/nymphs-world.git",
    "branch": "main"
  },
  "source": {
    "type": "repo",
    "repo": "https://github.com/nymphnerds/nymphs-world.git",
    "ref": "main"
  },
  "install": {
    "root": "$HOME/Nymphs-World",
    "entrypoint": "scripts/install_nymphs_world.sh",
    "version_marker": "$HOME/Nymphs-World/.nymph-module-version",
    "installed_markers": [
      "$HOME/Nymphs-World/.nymph-module-version"
    ]
  },
  "runtime": {
    "host": "127.0.0.1",
    "port": 8083,
    "frontend_url": "http://127.0.0.1:8083",
    "backend_url": "http://127.0.0.1:8083",
    "health_url": "http://127.0.0.1:8083/api/health",
    "server_info_url": "http://127.0.0.1:8083/server_info"
  },
  "artifacts": {
    "data_root": "$HOME/NymphsData/nymphs-world",
    "projects_root": "$HOME/NymphsData/nymphs-world/projects",
    "config_root": "$HOME/NymphsData/config/nymphs-world",
    "logs_root": "$HOME/NymphsData/logs/nymphs-world"
  },
  "entrypoints": {
    "install": "scripts/install_nymphs_world.sh",
    "update": "scripts/nymphs_world_update.sh",
    "status": "scripts/nymphs_world_status.sh",
    "start": "scripts/nymphs_world_start.sh",
    "stop": "scripts/nymphs_world_stop.sh",
    "open": "scripts/nymphs_world_open.sh",
    "logs": "scripts/nymphs_world_logs.sh",
    "open_projects": "scripts/nymphs_world_open_projects.sh",
    "smoke_test": "scripts/nymphs_world_smoke_test.sh",
    "uninstall": "scripts/nymphs_world_uninstall.sh"
  },
  "capabilities": [
    "install",
    "status",
    "start",
    "stop",
    "open",
    "logs",
    "uninstall"
  ],
  "ui": {
    "sort_order": 48,
    "standard_lifecycle_rail": true,
    "manager_ui": {
      "type": "local_url",
      "title": "Nymphs World",
      "url": "http://127.0.0.1:8083",
      "requires_running": true,
      "start_action": "open",
      "stop_action": "stop"
    },
    "manager_actions": [
      {
        "id": "open",
        "label": "Open UI",
        "entrypoint": "open",
        "result": "open_in_manager"
      },
      {
        "id": "smoke_test",
        "label": "Smoke Test",
        "entrypoint": "smoke_test",
        "result": "show_output"
      },
      {
        "id": "open_projects",
        "label": "Open Worlds",
        "entrypoint": "open_projects",
        "result": "open_directory"
      },
      {
        "id": "start",
        "label": "Start",
        "entrypoint": "start",
        "result": "show_output"
      },
      {
        "id": "stop",
        "label": "Stop",
        "entrypoint": "stop",
        "result": "show_output"
      },
      {
        "id": "logs",
        "label": "Logs",
        "entrypoint": "logs",
        "result": "open_notepad"
      }
    ]
  },
  "overview": {
    "body": "Private dev build. Current slice: WORBI-derived workspace UI running as the Nymphs World module, with data and logs kept under NymphsData while project-root adaptation continues. Codex Sign In is an optional provider lane for ChatGPT subscription-backed creative generation; Local/Brain and OpenRouter/API providers remain available."
  },
  "uninstall": {
    "supports_purge": true,
    "supports_data_delete": true,
    "requires_confirmation": true,
    "dry_run_arg": "--dry-run",
    "confirm_arg": "--yes",
    "purge_arg": "--purge",
    "data_only_arg": "--data-only",
    "preserve_by_default": [
      "projects",
      "config",
      "logs"
    ],
    "removes_by_default": [
      "app runtime files",
      "module scripts"
    ]
  },
  "dependencies": {
    "node": "Node.js and npm from the NymphsCore base runtime",
    "codex_cli": "Optional. Official standalone Codex CLI for the Codex Sign In provider lane; not required for Local/Brain or OpenRouter/API providers."
  },
  "update_policy": {
    "channel": "experimental"
  }
}
